<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build of the Selenium + TestNG page object framework.
  mvn test                                   runs testng.xml (the default suite)
  mvn test -DsuiteXmlFile=groupsTestng.xml   runs the groups suite (or ReportDemoSuite.xml)
  Browser, headless mode and waits come from src/main/resources/config.properties
  and can be overridden the same way, e.g. -Dbrowser=firefox -Dheadless=true
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.niranjankagri</groupId>
    <artifactId>java-selenium-testng-pom-framework</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Suite run by "mvn test"; pass -DsuiteXmlFile=groupsTestng.xml for the groups suite -->
        <suiteXmlFile>testng.xml</suiteXmlFile>
    </properties>

    <dependencies>
        <!-- Browser automation; Selenium Manager downloads the matching driver itself -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.51.0</version>
        </dependency>
        <!-- Test runner: groups, priorities, soft asserts, listeners -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
        </dependency>
        <!-- HTML report (Spark) with failure screenshots -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>5.1.2</version>
        </dependency>
        <!-- FileUtils.copyFile for screenshots -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.22.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Runs the TestNG suite file. Held at 3.5.6: 3.6.0 picks the JUnit Platform
                 provider in TestNG projects and ignores the suite file and its listeners -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
